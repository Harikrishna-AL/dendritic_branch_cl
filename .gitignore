__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.claude/

# Datasets are downloaded into data_cache/, never committed.
data_cache/

# Checkpoints are regenerated by the scripts.
*.pt
*.pth
*.npz

# The parent repo ignores data/ and results/ wholesale; re-include ours.
!/data/
!/data/splits/
!/data/splits/mnist_split_indices.npz
!/results/

# Archive: keep code, notes and reports; leave out bulky data, clones and raw runs.
archive/results/
archive/external/
archive/upstream_bdh/
archive/data/
archive/tmp/
archive/output/
archive/bdh_cl_legacy/data_cache/
archive/bdh_cl_legacy/results/
!archive/v1_results/

# Local build caches and run logs (logs contain local paths).
node_modules
.build/
*.log
